# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon serverless Postgres — use the POOLED connection
# (the "-pooler" host on port 6543). The direct connection will not work
# with @neondatabase/serverless.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# POS login passcodes. Optional — when unset the POS falls back to the
# built-in defaults admin123 / staff123. Set them to something private.
ADMIN_PASSCODE=
STAFF_PASSCODE=
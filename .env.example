# Local environment for the Sakthi Pugaazhu Tex POS.
# NEVER commit this file - .gitignore covers .env*

# Neon serverless Postgres.
# Use the POOLED connection string (the "-pooler" host on port 6543).
# The direct connection will NOT work with @neondatabase/serverless.
# Neon Console -> your project -> Connection Details -> Pooled connection
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# POS login passcodes. Generate your own strong values and set them in BOTH
# .env.local (local dev) and the Vercel project environment variables.
# Generate with:  node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_PASSCODE=""
STAFF_PASSCODE=""